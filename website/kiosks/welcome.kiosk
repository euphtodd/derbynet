}

/* ── Divider ─────────────────────────────────────────── */
.welcome-divider {
  width: 60%;
  max-width: 600px;
  height: 1px;
  background: linear-gradient(to right, transparent, var(--pintwood-citrine), transparent);
  opacity: 0.5;
}

/* ── Results URL + QR ────────────────────────────────── */
.welcome-results {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24px;
  padding-bottom: 16px;
}

.welcome-results-text {
  display: flex;
  flex-direction: column;
