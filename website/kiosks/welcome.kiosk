}

#welcome-qrcode img,
#welcome-qrcode canvas {
  display: block;
  border: 6px solid white;
  border-radius: 4px;
}
</style>
<script type="text/javascript">
$(function() {
  var dim = Math.round(Math.min(0.12 * window.screen.width, 140));
  dim = Math.max(dim, 80);

  new QRCode(document.getElementById("welcome-qrcode"), {
    text: "https://race.indypintwoodderby.com",
    width: dim,
    height: dim
  });
});
</script>
</head>
