<style type="text/css">
/* Hide the default banner */
.banner { display: none !important; }

body.pintwood-dark {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  overflow: hidden;
}

/* ── Hero area ─────────────────────────────────────── */
.welcome-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  text-align: center;
  padding: 20px 40px;
  gap: 0;
}

/* "Welcome to the inaugural" */
.welcome-pre {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(22px, 3.5vw, 42px);
  font-weight: 300;
  color: var(--pintwood-muted-text);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin: 0;
}

/* Logo + wordmark lockup (large version of header branding) */
.welcome-identity {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
}

.welcome-identity img.event-logo {
  height: clamp(80px, 10vw, 140px);
  width: auto;
}

.welcome-wordmark {
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  text-align: left;
}

.welcome-wordmark .top-line {
  display: block;
  color: var(--pintwood-muted-text);
  font-size: clamp(22px, 3vw, 42px);
  letter-spacing: 0.25em;
  font-weight: 300;
  text-transform: uppercase;
}

.welcome-wordmark .highlight {
  display: block;
  color: var(--pintwood-citrine);
  font-weight: 900;
  font-size: clamp(36px, 6vw, 88px);
  text-transform: uppercase;
  letter-spacing: 0.04em;
  line-height: 1;
  margin-left: -3px;
}

/* ── "Presented by" + sponsor logos ─────────────────── */
.welcome-presented-by {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  padding: 10px 0;
}

.welcome-presented-by .presented-label {
  font-family: 'Montserrat', sans-serif;
  font-size: clamp(13px, 1.6vw, 20px);
  font-weight: 400;
  color: var(--pintwood-muted-text);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin: 0;
}

.welcome-sponsors {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}

.welcome-sponsors img {
  max-height: clamp(60px, 9vw, 130px);
